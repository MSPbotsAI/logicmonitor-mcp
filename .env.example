# Optional overrides — logicmonitor-mcp has no required env vars.
# Authentication is per-request via three request headers:
#   X-LogicMonitor-Company     — the LogicMonitor portal subdomain
#                                 (https://{company}.logicmonitor.com)
#   X-LogicMonitor-Access-Id   — LMv1 API token Access ID
#   X-LogicMonitor-Access-Key  — LMv1 API token Access Key (secret)
#
# This server signs each request itself using the LMv1 HMAC-SHA256 scheme
# (matching how LogicMonitor is configured in MSPbots: Company + Access Id +
# Access Key). It never persists these values — they are read from headers
# per request and held only for the lifetime of that request.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
